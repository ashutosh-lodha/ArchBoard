# Copy to .env for local development. Nothing here is secret.
NODE_ENV=development
LOG_LEVEL=debug
PUBLIC_ORIGIN=http://localhost:5180

# Postgres from `pnpm dev:services` (Docker, localhost only)
DATABASE_URL=postgresql://archboard:archboard@localhost:5432/archboard
API_PORT=3000

# Clerk (optional locally). Without these, the editor runs in browser-only mode with no sign-in.
# Both values are public: the publishable key (Dashboard → API keys) and the JWT public key
# (Dashboard → API keys → JWKS public key, PEM, with newlines written as \n).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
