# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=debug
PUBLIC_ORIGIN=http://localhost:5180

DATABASE_URL=postgresql://archboard:archboard@localhost:5432/archboard
REDIS_URL=redis://localhost:6379

API_PORT=3000
SYNC_PORT=4000

# Clerk (dev instance): https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Storage: "local" (writes to ./.data) or "gcs"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data
GCS_BUCKET=
