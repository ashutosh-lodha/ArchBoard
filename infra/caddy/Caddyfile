# ArchBoard production edge (DESIGN §9.3). Caddy owns :80/:443 and gets/renews the TLS
# certificate automatically. Today it serves the static SPA; /api and /ws are added when the
# API and sync services are deployed.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

archboard.ashutoshdev.online {
	import security_headers
	encode zstd gzip

	# Releases live in /srv/archboard/releases/<git-sha>; "current" is swapped atomically on deploy.
	root * /srv/archboard/current

	# Hashed build assets never change: cache for a year. index.html must always revalidate.
	@immutable path /assets/* /icons/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# Single-page app: unknown paths fall back to index.html (client-side routing).
	try_files {path} /index.html
	file_server
}

www.archboard.ashutoshdev.online {
	redir https://archboard.ashutoshdev.online{uri} permanent
}
