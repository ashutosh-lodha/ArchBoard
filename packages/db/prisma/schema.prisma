// ArchBoard data model.
// Migration policy: expand → deploy → contract. Never drop or rename a column in the same
// release as the code that stops using it.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A board. Policy: one board per account (unique ownerId), deleted automatically 7 days after
/// it was created (hourly cleanup job in the API, and checked on every request).
/// No personal data is stored: the owner is identified only by their Clerk user id.
model Board {
  id             String   @id @default(cuid())
  /// Clerk user id ("user_…") of the owner.
  ownerId        String   @unique
  title          String   @default("Untitled board") @db.VarChar(120)
  /// The board's Yjs document: every saved update merged into one state (Y.mergeUpdates).
  content        Bytes?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime @default(dbgenerated("(now() + '7 days'::interval)"))

  @@index([expiresAt])
}
